{
  "name": "blackjack-web",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src docs README.md README.zh-CN.md AGENTS.md index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src docs README.md README.zh-CN.md AGENTS.md index.html package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
